<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>{% block title %}Intervention Lab{% endblock %}</title>

        <link id="theme" rel="stylesheet" href="{{ asset('css/style.css')}}">
    </head>

    <body class="d-flex flex-column min-vh-100">
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
                <div class="container">
                    <a
                        class="navbar-brand fw-bold d-flex align-items-center gap-2"
                        href="{{ path('app_home') }}"
                    >
                        <i class="bi bi-fire fs-5"></i>
                        Intervention<span class="fw-light">Lab</span>
                    </a>

                    <button
                        class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Ouvrir ou fermer la navigation"
                    >
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                            <li class="nav-item">
                                <a
                                    class="nav-link {% if app.request.get('_route') == 'app_home' %}active fw-semibold{% endif %}"
                                    href="{{ path('app_home') }}"
                                    {% if app.request.get('_route') == 'app_home' %}
                                        aria-current="page"
                                    {% endif %}
                                >
                                    <i class="bi bi-house-door me-1"></i>
                                    Accueil
                                </a>
                            </li>

                            <li class="nav-item">
                                <a
                                    class="nav-link {% if app.request.get('_route') == 'app_scenarios' %}active fw-semibold{% endif %}"
                                    href="{{ path('app_scenarios') }}"
                                    {% if app.request.get('_route') == 'app_scenarios' %}
                                        aria-current="page"
                                    {% endif %}
                                >
                                    <i class="bi bi-list-task me-1"></i>
                                    Scénarios
                                </a>
                            </li>

                            <li class="nav-item">
                                <a
                                    class="nav-link {% if app.request.get('_route') == 'app_account' %}active fw-semibold{% endif %}"
                                    href="{{ path('app_account') }}"
                                    {% if app.request.get('_route') == 'app_account' %}
                                        aria-current="page"
                                    {% endif %}
                                >
                                    <i class="bi bi-person-circle me-1"></i>
                                    Mon compte
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main class="site-main flex-grow-1 py-4">
            <div class="container">
                {% block body %}{% endblock %}
            </div>
        </main>

        <footer class="site-footer bg-dark text-white-50 py-4 mt-auto">
            <div class="container">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                    <div class="fw-bold text-white">
                        Intervention<span class="text-warning">Lab</span>
                    </div>

                    <p class="mb-0 small text-center text-md-end">
                        Projet pédagogique — simulations fictives, non destinées
                        à guider une intervention réelle.
                    </p>
                </div>
            </div>
        </footer>

                {# Bootstrap JS : indispensable pour le menu mobile #}
        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"
        ></script>

        {% block javascripts %}{% endblock %}
    </body>
</html>