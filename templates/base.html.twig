<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">

        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>{% block title %}Intervention Lab{% endblock %}</title>

        <link rel="stylesheet" href="{{ asset('css/style.css') }}">

        {% block stylesheets %}{% endblock %}
    </head>

    <body>
        <header class="site-header">
            <div class="container header-content">

                <nav aria-label="Navigation principale">
                    <a href="{{ path('app_home') }}" class="nav-link">
                        Accueil
                    </a>

                    <a href="{{ path('app_scenarios') }}" class="nav-link">
                        Scénarios
                    </a>
                    <a href="{{ path('app_account') }}" class="nav-link">
                        Mon compte
                    </a>
                </nav>
            </div>
        </header>

        <main class="container">
            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <div class="container">
                Projet pédagogique — simulations fictives, non destinées
                à guider une intervention réelle.
            </div>
        </footer>

        {% block javascripts %}{% endblock %}
    </body>
</html>